{
  "NOMBRE_PROYECTO": "Juego de Ejemplo",
  "DESCRIPCION_PRODUCTO": "Juego de plataformas 2D para un jugador, sin compras dentro del juego.",
  "MOTOR": "Unity 6",
  "MOTOR_EXTRA": "unity",
  "PLATAFORMAS": "PC (Windows, Steam)",
  "LENGUAJE": "C#",
  "GUIA_BUENAS_PRACTICAS": "https://docs.unity3d.com/Manual/BestPracticeGuides.html",
  "ZONA_HORARIA": "Europe/Madrid",
  "ZONA_HORARIA_POSIX": "CET-1CEST,M3.5.0,M10.5.0/3",
  "RAMA_PRINCIPAL": "main",
  "ROLES": ["coordinador", "arquitecto-sistemas", "especialista-escenas-ui", "director-arte", "auditor-calidad", "disenador-sonido"],
  "BINARIO_MOTOR": "Unity",
  "REGEX_BINARIO_MOTOR": "^unity(\\.exe)?$",
  "ARGS_MOTOR_SILENCIOSO": "-batchmode -nographics -logFile -",
  "ARG_RUTA_PROYECTO": "-projectPath",
  "REGEX_ERRORES_MOTOR": "error CS[0-9]+|Scripts have compiler errors|Exception:",
  "CANDADO_BUILD": "build_pc",
  "COMANDO_BUILD_EJEMPLO": "./tools/motor_silencioso.sh arquitecto-sistemas -quit -executeMethod Build.Windows",
  "CONFIG_MOTOR": ["ProjectSettings/**", "Packages/manifest.json", "Packages/packages-lock.json"],
  "RUTA_NUCLEO": ["Assets/Scripts/**", "Assets/Scripts.meta"],
  "RUTA_ESCENAS": ["Assets/Scenes/**", "Assets/Scenes.meta", "Assets/Prefabs/**", "Assets/Prefabs.meta", "Assets/UI/**", "Assets/UI.meta"],
  "RUTA_ARTE": ["Assets/Art/**", "Assets/Art.meta"],
  "RUTA_TESTS": ["Assets/Tests/**", "Assets/Tests.meta"],
  "IGNORAR_MOTOR": ["Library/", "Temp/", "Obj/", "Build/", "Builds/", "Logs/", "UserSettings/"],
  "MODELO_EJECUTOR": "sonnet",
  "MODELO_LECTOR": "haiku",
  "CUOTA": "a decidir por la persona responsable",
  "MAX_SESIONES": "2"
}
