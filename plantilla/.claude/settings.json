{
  "permissions": {
    "deny": [
      "Agent(Explore)",
      "Agent(general-purpose)",
      "Agent(Plan)",
      "Agent(claude)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/pre_tool_guard.sh\"",
            "timeout": 15,
            "statusMessage": "Comprobando normas de órdenes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_propiedad.sh\"",
            "timeout": 15,
            "statusMessage": "Comprobando propiedad del archivo"
          }
        ]
      }
    ]
  }
}
