{
  "permissions": {
    "deny": [
      "Agent(Explore)",
      "Agent(general-purpose)",
      "Agent(Plan)",
      "Agent(claude)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/linea_estado.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/inicio_sesion.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/aviso_contexto.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/pre_tool_guard.sh\"",
            "timeout": 15,
            "statusMessage": "Comprobando normas de órdenes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_propiedad.sh\"",
            "timeout": 15,
            "statusMessage": "Comprobando propiedad del archivo"
          }
        ]
      }
    ]
  }
}
